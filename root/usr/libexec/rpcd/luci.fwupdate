#!/bin/sh
# luci-app-fwupdate —— rpcd 后端
#
# rpcd 协议：`<script> list` 输出方法表；`<script> call <method>` 从 stdin
# 读 JSON 参数，把结果 JSON 打到 stdout。所有方法都返回 { "ok": true/false }。
#
# 设计要点：
#   * check 只调 GitHub API（几秒内返回），不在 rpcd 里做 40MB 下载；
#   * start 把 /usr/bin/fwupdate 丢到后台跑，立刻返回，前端轮询 log 看重进度；
#   * 真正的下载/校验/刷写逻辑全在 /usr/bin/fwupdate 里，这里只是壳。

. /usr/share/libubox/jshn.sh

BIN=/usr/bin/fwupdate
STATE_DIR=/etc/fwupdate
# 检查结果放持久目录而不是 /tmp：更新说明只有 API 能给，而 API 按 IP 每小时
# 只有 60 次；缓存到磁盘后，同版本只需取一次，重启也不至于又要去问一次。
CACHE=$STATE_DIR/check.json
LOG=/tmp/fwupdate.log
DLDIR=/tmp/fwupdate.d
REPO_FALLBACK=/etc/fwupdate-repo
VER_FILE=/etc/fw-version
RESULT=$STATE_DIR/result.json
STORE=/mnt/fwstore
UA='luci-app-fwupdate'

# 插件自身：仓库、构建时写入的 commit 短 sha、以及远端检查缓存
SELF_REPO='novzhhho/luci-app-fwupdate'
BUILD_FILE=/usr/share/luci-app-fwupdate/build
SELF_CACHE=$STATE_DIR/self.json

cfg() { uci -q get "fwupdate.main.$1" 2>/dev/null; }

get_repo() {
	local r
	r=$(cfg repo)
	[ -n "$r" ] || r=$(tr -d ' \r\n' < "$REPO_FALLBACK" 2>/dev/null)
	echo "$r"
}

get_cur() { tr -d ' \r\n' < "$VER_FILE" 2>/dev/null; }

# ------------------------------------------------------------ GitHub 探测
# 匿名访问 api.github.com 按**出口 IP** 每小时只有 60 次配额，正常点几下
# 「检查更新」就能耗尽，然后整整一小时里每次都是 403 —— 这不是"过几分钟
# 再试"的事。但下面两条网页路径不消耗 API 配额：
#   1. /releases/latest 会 302 到 /releases/tag/<tag>，tag 就在 Location 里
#   2. /releases/expanded_assets/<tag> 返回一段 HTML，含全部资产的下载路径
# 于是把 API 降级成"只用来取更新说明"：取不到就不带说明，绝不能因此把一次
# 成功的检查判成失败。
# 注意：这两个是**全局**变量，由下面的函数直接赋值。
# 不能写成 TAG=$(gh_latest_tag)——命令替换会开子 shell，函数里设置的状态码
# 出不来，于是每次都被当成"连不上"（踩过）。
GH_CODE=''
GH_TAG=''

gh_latest_tag() {
	local out loc
	# 用 GET + %{redirect_url} 拿 Location。不要用 -I(HEAD)：实测同一仓库
	# 的 HEAD 会莫名其妙报 000，而 GET 正常 302（GitHub 边缘节点行为不一致）。
	out=$(curl -s -o /dev/null --connect-timeout 8 -m 20 \
		-H "User-Agent: $UA" -w '%{http_code} %{redirect_url}' \
		"https://github.com/$1/releases/latest" 2>/dev/null)
	GH_CODE=${out%% *}
	loc=${out#* }
	GH_TAG=''
	case "$loc" in
		*/releases/tag/*) GH_TAG=${loc##*/releases/tag/} ;;
	esac
}

gh_assets() {
	[ -n "$2" ] || return 0
	curl -s --connect-timeout 8 -m 25 -H "User-Agent: $UA" \
		"https://github.com/$1/releases/expanded_assets/$2" 2>/dev/null \
		| grep -oE "$1/releases/download/[^\"'<> ]+" | sort -u
}

# 取资产大小。同样避开 HEAD：用 Range 只请 2 字节，从 Content-Range 的
# "bytes 0-1/<总长>" 里读总长；服务器不支持 Range 时退回 Content-Length。
# 注意中间那跳 302 的 Content-Length 是 0，所以一律取最后一个匹配。
gh_asset_size() {
	local _h _n
	_h=$(curl -sL -r 0-1 -o /dev/null -D - --connect-timeout 8 -m 30 \
		-H "User-Agent: $UA" "$1" 2>/dev/null)
	_n=$(printf '%s\n' "$_h" \
		| sed -n 's|^[Cc]ontent-[Rr]ange:[^/]*/||p' | tr -d '\r' | tail -n1)
	if [ -z "$_n" ]; then
		_n=$(printf '%s\n' "$_h" \
			| sed -n 's|^[Cc]ontent-[Ll]ength:[[:space:]]*||p' | tr -d '\r' | tail -n1)
	fi
	printf '%s' "$_n"
}

# 更新说明只有 API 有。失败（含 403）就返回空，调用方当作"没有说明"。
gh_body() {
	curl -s --connect-timeout 8 -m 20 \
		-H 'Accept: application/vnd.github+json' -H "User-Agent: $UA" \
		"https://api.github.com/repos/$1/releases/tags/$2" 2>/dev/null \
		| jsonfilter -e '@.body' 2>/dev/null
}

# 后台升级是否在跑。
# 不能用 `pgrep -f "$BIN"`：那会把「命令行里只是提到这个路径」的进程也算进
# 来（比如在 SSH 里 grep / 编辑它），于是界面莫名其妙报「已有任务在运行」。
# 优先按进程名精确匹配；setsid 之前进程名是 sh，再退到锚定行首的命令行匹配。
is_running() {
	if command -v pgrep >/dev/null 2>&1; then
		pgrep -x fwupdate >/dev/null 2>&1 && return 0
		pgrep -f "^$BIN( |\$)" >/dev/null 2>&1 && return 0
		return 1
	fi
	ps w 2>/dev/null | grep -v grep | grep -qE "(^| )$BIN( |\$)"
}

reply_err() {
	json_init
	json_add_boolean ok 0
	json_add_string error "$1"
	json_dump
}

# jshn 的 json_add_int 收到空值会吐出一段非法 JSON（`"key": ,`），整条 ubus 回包
# 就废了。凡是从 jsonfilter / sed 里取来的数字，一律过这里兜成 0。
jint() {
	local v
	v="$2"
	case "$v" in ''|*[!0-9-]*) v=0 ;; esac
	json_add_int "$1" "$v"
}

# ---------------------------------------------------------------- status
do_status() {
	local cur repo latest size ts has

	cur=$(get_cur)
	repo=$(get_repo)

	json_init
	json_add_boolean ok 1
	json_add_string current "$cur"
	json_add_string repo "$repo"
	json_add_string mirror "$(cfg mirror)"
	json_add_boolean has_bin "$([ -x "$BIN" ] && echo 1 || echo 0)"

	if [ -f "$CACHE" ]; then
		latest=$(jsonfilter -i "$CACHE" -e '@.tag' 2>/dev/null)
		size=$(jsonfilter -i "$CACHE" -e '@.size' 2>/dev/null)
		ts=$(jsonfilter -i "$CACHE" -e '@.checked_at' 2>/dev/null)
		pub=$(jsonfilter -i "$CACHE" -e '@.published_at' 2>/dev/null)
		body=$(jsonfilter -i "$CACHE" -e '@.body' 2>/dev/null)
		has=0
		[ -n "$latest" ] && [ "$latest" != "$cur" ] && has=1
		json_add_string latest "$latest"
		json_add_int size "${size:-0}"
		json_add_int checked_at "${ts:-0}"
		json_add_string published_at "$pub"
		json_add_string body "$body"
		json_add_boolean has_update "$has"
	else
		json_add_string latest ""
		json_add_int size 0
		json_add_int checked_at 0
		json_add_string published_at ""
		json_add_string body ""
		json_add_boolean has_update 0
	fi

	json_add_boolean running "$(is_running && echo 1 || echo 0)"

	# 持久分区（p3）：有它才有完整备份和镜像缓存
	if awk -v p="$STORE" '$2==p{f=1} END{exit !f}' /proc/mounts 2>/dev/null; then
		json_add_boolean store 1
		json_add_int store_free "$(df -k "$STORE" 2>/dev/null | awk 'NR==2{print $4 * 1024}')"
	else
		json_add_boolean store 0
		json_add_int store_free 0
	fi

	# 上次升级的自证结果：由开机脚本写在 result.json，只报告一次
	# 注意 jshn 的 json_add_int 不接受空值（会写出非法 JSON），所以统一走
	# 这两个小包装，缺字段时给安全默认值。
	rj() { jsonfilter -i "$RESULT" -e "$1" 2>/dev/null; }
	rn() { local v; v=$(rj "$1"); case "$v" in ''|*[!0-9]*) echo 0 ;; *) echo "$v" ;; esac; }

	json_add_string last_status ""
	json_add_string last_from ""
	json_add_string last_to ""
	json_add_int    last_total 0
	json_add_int    last_ok 0
	json_add_int    last_changed 0
	json_add_int    last_missing 0
	json_add_int    last_at 0
	json_add_int    last_elapsed 0
	json_add_boolean last_store 0

	if [ -f "$RESULT" ]; then
		json_add_string last_status "$(rj '@.status')"
		json_add_string last_from   "$(rj '@.from')"
		json_add_string last_to     "$(rj '@.to')"
		json_add_int    last_total   "$(rn '@.total')"
		json_add_int    last_ok      "$(rn '@.ok')"
		json_add_int    last_changed "$(rn '@.changed')"
		json_add_int    last_missing "$(rn '@.missing')"
		json_add_int    last_at      "$(rn '@.at')"
		json_add_int    last_elapsed "$(rn '@.elapsed')"
		json_add_boolean last_store  "$(rj '@.restored_from_store')"
	fi

	json_dump
}

# ---------------------------------------------------------------- check
do_check() {
	local repo tag assets url size pub cur has body

	repo=$(get_repo)
	[ -n "$repo" ] || { reply_err "还没有配置 GitHub 仓库（owner/repo）"; return; }
	case "$repo" in
		*/*) ;;
		*) reply_err "仓库格式应为 owner/repo"; return ;;
	esac

	cur=$(get_cur)
	mkdir -p "${CACHE%/*}" 2>/dev/null

	# 第一步：零配额探测最新 tag。
	# 判定以"拿到 tag"为准，而不是以状态码为准——有些代理/加速层会把 302
	# 改写成 200 但照样带着 Location，死抠 302 会误判成失败。
	gh_latest_tag "$repo"
	tag=$GH_TAG
	if [ -z "$tag" ]; then
		case "$GH_CODE" in
			404) reply_err "仓库不存在，或该仓库还没有发布 Release（HTTP 404）"; return ;;
			429) reply_err "GitHub 网页请求也被限流了（HTTP 429），等几分钟再试"; return ;;
			''|000) reply_err "连不上 GitHub（检查路由器网络 / DNS）"; return ;;
		esac
		reply_err "解析 Releases 跳转失败（HTTP ${GH_CODE:-?}，没拿到 tag）"
		return
	fi

	has=0
	[ -n "$cur" ] && [ "$tag" != "$cur" ] && has=1

	# 第二步：零配额列资产 + 零配额取大小
	assets=$(gh_assets "$repo" "$tag")
	url=$(printf '%s\n' "$assets" | grep -E '\.img\.gz$' | head -n1)
	[ -n "$url" ] || url=$(printf '%s\n' "$assets" | grep -E '\.img$' | head -n1)
	[ -n "$url" ] || { reply_err "该 Release 里没有 .img.gz / .img 资产"; return; }
	url="https://github.com/$url"
	size=$(gh_asset_size "$url")
	case "$size" in ''|*[!0-9]*) size=0 ;; esac

	# 第三步：更新说明。tag 没变就复用缓存，变了才去问一次 API；问不到就不带
	# 说明，照样把检查结果正常返回。
	pub=''; body=''
	if [ "$has" = 0 ] && [ -f "$CACHE" ] \
	   && [ "$(jsonfilter -i "$CACHE" -e '@.tag' 2>/dev/null)" = "$tag" ]; then
		pub=$(jsonfilter -i "$CACHE" -e '@.published_at' 2>/dev/null)
		body=$(jsonfilter -i "$CACHE" -e '@.body' 2>/dev/null)
	else
		body=$(gh_body "$repo" "$tag")
	fi
	[ -n "$body" ] && [ ${#body} -gt 3000 ] && body=$(printf '%s' "$body" | head -c 3000)

	json_init
	json_add_string tag "$tag"
	json_add_string url "$url"
	jint size "$size"
	json_add_string published_at "$pub"
	json_add_int checked_at "$(date +%s)"
	json_add_string body "$body"
	json_dump > "$CACHE"
	json_cleanup

	json_init
	json_add_boolean ok 1
	json_add_string current "$cur"
	json_add_string tag "$tag"
	json_add_string url "$url"
	jint size "$size"
	json_add_string published_at "$pub"
	json_add_int checked_at "$(date +%s)"
	json_add_string body "$body"
	json_add_boolean has_update "$has"
	json_dump
}

# ---------------------------------------------------------------- start
do_start() {
	local repo

	repo=$(get_repo)
	[ -n "$repo" ] || { reply_err "还没有配置 GitHub 仓库"; return; }
	[ -x "$BIN" ] || { reply_err "缺少升级引擎 $BIN"; return; }
	is_running && { reply_err "已有升级任务在运行"; return; }

	: > "$LOG"

	# 后台跑，rpcd 退出不影响它。
	# 注意：`start-stop-daemon -b` 会把子进程的 stdout/stderr 接到 /dev/null（实测日志
	# 恒为 0 字节），重定向必须在子进程内部做才留得住。setsid + sh -c 已验证可用。
	if command -v setsid >/dev/null 2>&1; then
		setsid /bin/sh -c "exec $BIN -y >>$LOG 2>&1" </dev/null &
	else
		start-stop-daemon -S -b -q -x "$BIN" -- -y
	fi

	json_init
	json_add_boolean ok 1
	json_dump
}

# ---------------------------------------------------------------- log
do_log() {
	local run=0 sz=0 total=0

	is_running && run=1
	[ -f "$CACHE" ] && total=$(jsonfilter -i "$CACHE" -e '@.size' 2>/dev/null)

	# 镜像可能落在持久分区（缓存复用），所以以 fwupdate 写的路径文件为准，
	# 拿不到再退回按扩展名找 /tmp 里的下载文件
	if [ -f "$DLDIR/current.path" ]; then
		p=$(cat "$DLDIR/current.path" 2>/dev/null)
		[ -n "$p" ] && [ -f "$p" ] && sz=$(wc -c < "$p" 2>/dev/null)
	fi
	[ -n "$sz" ] || sz=$(ls -l "$DLDIR"/*.img.gz "$DLDIR"/*.img 2>/dev/null | head -n1 | awk '{print $5}')

	json_init
	json_add_boolean ok 1
	json_add_boolean running "$run"
	json_add_string log "$(tail -c 6000 "$LOG" 2>/dev/null)"
	json_add_int downloaded "${sz:-0}"
	json_add_int total "${total:-0}"
	json_dump
}

# ---------------------------------------------------------------- setconfig
do_setconfig() {
	local payload repo mirror

	payload=$(cat)
	json_load "$payload" 2>/dev/null
	json_get_var repo repo
	json_get_var mirror mirror

	case "$repo" in
		'') ;;
		*[!A-Za-z0-9._/-]*) reply_err "仓库名含非法字符"; return ;;
		*/*) ;;
		*) reply_err "仓库格式应为 owner/repo"; return ;;
	esac

	case "$mirror" in
		'') ;;
		http://*|https://*) ;;
		*) reply_err "镜像地址要以 http:// 或 https:// 开头"; return ;;
	esac

	uci -q get fwupdate.main >/dev/null 2>&1 || uci -q set fwupdate.main=fwupdate
	uci -q set "fwupdate.main.repo=$repo"
	uci -q set "fwupdate.main.mirror=$mirror"
	uci -q commit fwupdate || { reply_err "写入 uci 失败"; return; }

	# 仓库变了，旧检查结果作废
	rm -f "$CACHE"

	json_init
	json_add_boolean ok 1
	json_dump
}

# ---------------------------------------------------------------- 插件自更新
# 说明：插件是纯 shell + JS，编译产物就是一个几 KB 的 apk。CI 每次 push 都会
# 构建并把 apk 挂到 tag=<commit 短 sha> 的 Release 上，这里比对本地烧进去的
# sha 与 Release 的 tag，不同就说明有新版本，直接 apk add 覆盖安装。
self_local() { tr -d ' \r\n' < "$BUILD_FILE" 2>/dev/null; }

# 已装包的 revision 号（luci-app-fwupdate-1.0.0-r12 → 12）。
# PKG_RELEASE 在 CI 里取 commit 数，所以它单调递增，可以用来判新旧。
self_rev() {
	apk list -I luci-app-fwupdate 2>/dev/null \
		| sed -n 's/^luci-app-fwupdate-[^ ]*-r\([0-9][0-9]*\)[ ].*/\1/p' | head -n1
}

# 从 apk 下载地址里抠 revision（...-1.0.0-r12.apk → 12），抠不出返回空。
# 先砍掉 ?query 和 #frag：加速前缀/跳转链接可能带尾巴，不砍就匹配不上。
rev_of_url() {
	local u="${1%%\?*}"
	u="${u%%#*}"
	echo "${u##*/}" | sed -n 's/.*-r\([0-9][0-9]*\)\.apk$/\1/p'
}

# 远端是否**真的更新**。只比 sha 相等/不等是不够的：sha 是内容指纹，不含时序，
# 旧缓存的 sha 不同也会被判成"有新版"，一装就是降级（实测踩过）。
is_newer() {
	_lr=$1; _rr=$2; _ls=$3; _rs=$4
	if [ -n "$_lr" ] && [ -n "$_rr" ]; then
		[ "$_rr" -gt "$_lr" ] && return 0
		return 1
	fi
	# 任一边取不到 revision 时退回比对 sha，但至少要求远端 sha 非空
	[ -n "$_rs" ] && [ "$_rs" != "$_ls" ]
}

do_self_status() {
	local local_sha local_rv remote rr has ts

	local_sha=$(self_local)
	local_rv=$(self_rev)
	remote=''; rr=''; has=0; ts=0

	if [ -f "$SELF_CACHE" ]; then
		remote=$(jsonfilter -i "$SELF_CACHE" -e '@.tag' 2>/dev/null)
		rr=$(jsonfilter -i "$SELF_CACHE" -e '@.rev' 2>/dev/null)
		ts=$(jsonfilter -i "$SELF_CACHE" -e '@.checked_at' 2>/dev/null)
		case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
		[ -z "$rr" ] && rr=$(rev_of_url "$(jsonfilter -i "$SELF_CACHE" -e '@.url' 2>/dev/null)")
		[ -n "$remote" ] && is_newer "$local_rv" "$rr" "$local_sha" "$remote" && has=1
	fi

	json_init
	json_add_boolean ok 1
	json_add_string local "${local_sha:-dev}"
	json_add_string remote "$remote"
	jint local_rev "$local_rv"
	jint remote_rev "$rr"
	json_add_int checked_at "$ts"
	json_add_boolean has_update "$has"
	json_dump
}

do_self_check() {
	local tag assets url size pub local_sha local_rv rr has

	mkdir -p "${SELF_CACHE%/*}" 2>/dev/null

	# 与固件检查同一套路：302 拿 tag + HTML 列资产，全程不碰 API 配额
	gh_latest_tag "$SELF_REPO"
	tag=$GH_TAG
	if [ -z "$tag" ]; then
		case "$GH_CODE" in
			404) reply_err "插件仓库还没有发布过构建（HTTP 404）"; return ;;
			429) reply_err "GitHub 网页请求也被限流了（HTTP 429），等几分钟再试"; return ;;
			''|000) reply_err "连不上 GitHub（检查路由器网络 / DNS）"; return ;;
		esac
		reply_err "解析 Releases 跳转失败（HTTP ${GH_CODE:-?}，没拿到 tag）"
		return
	fi

	assets=$(gh_assets "$SELF_REPO" "$tag")
	url=$(printf '%s\n' "$assets" | grep -E 'luci-app-fwupdate.*\.apk$' | head -n1)
	[ -n "$url" ] || { reply_err "该 Release 里没有插件 apk"; return; }
	url="https://github.com/$url"

	size=$(gh_asset_size "$url")
	case "$size" in ''|*[!0-9]*) size=0 ;; esac
	# 发布时间网页路径拿不到；tag 没变就沿用上次记下的
	pub=''
	if [ -f "$SELF_CACHE" ] \
	   && [ "$(jsonfilter -i "$SELF_CACHE" -e '@.tag' 2>/dev/null)" = "$tag" ]; then
		pub=$(jsonfilter -i "$SELF_CACHE" -e '@.published_at' 2>/dev/null)
	fi
	rr=$(rev_of_url "$url")

	json_init
	json_add_string tag "$tag"
	json_add_string url "$url"
	jint size "$size"
	json_add_string published_at "$pub"
	jint rev "$rr"
	json_add_int checked_at "$(date +%s)"
	json_dump > "$SELF_CACHE"
	json_cleanup

	local_sha=$(self_local)
	local_rv=$(self_rev)
	has=0
	is_newer "$local_rv" "$rr" "$local_sha" "$tag" && has=1

	json_init
	json_add_boolean ok 1
	json_add_string local "${local_sha:-dev}"
	json_add_string remote "$tag"
	json_add_string url "$url"
	json_add_int size "${size:-0}"
	json_add_string published_at "$pub"
	json_add_boolean has_update "$has"
	json_dump
}

do_self_update() {
	local url tmp out rc before after rtag rrev lrev lsha

	url=$(jsonfilter -i "$SELF_CACHE" -e '@.url' 2>/dev/null)
	[ -n "$url" ] || { reply_err "请先检查插件更新"; return; }

	# 装机前必须再确认一次"远端确实更新"。缓存可能来自几天前（/tmp 里的文件
	# 不重启就不会消失），那时的 latest 也许比现在装的还旧——照装就是降级。
	# 这一步是兜底，不能省：界面按钮的禁用只是提示，ubus 可以被直接调用。
	rtag=$(jsonfilter -i "$SELF_CACHE" -e '@.tag' 2>/dev/null)
	rrev=$(jsonfilter -i "$SELF_CACHE" -e '@.rev' 2>/dev/null)
	[ -z "$rrev" ] && rrev=$(rev_of_url "$url")
	lrev=$(self_rev)
	lsha=$(self_local)

	if ! is_newer "$lrev" "$rrev" "$lsha" "$rtag"; then
		rm -f "$SELF_CACHE"
		reply_err "远端构建（r${rrev:-?} / ${rtag:-未取到}）不比已装的（r${lrev:-?} / ${lsha:-dev}）新，已拒绝安装并清掉过期缓存，请重新检查"
		return
	fi

	tmp=/tmp/luci-app-fwupdate-new.apk
	rm -f "$tmp"

	curl -fsSL --retry 2 --connect-timeout 10 -m 120 -o "$tmp" "$url" 2>/dev/null \
		|| { rm -f "$tmp"; reply_err "下载插件包失败"; return; }
	[ -s "$tmp" ] || { rm -f "$tmp"; reply_err "下载到的插件包为空"; return; }

	before=$(self_local)
	out=$(apk add --no-network --allow-untrusted --force-overwrite "$tmp" 2>&1)
	rc=$?
	rm -f "$tmp"

	[ "$rc" = 0 ] || { reply_err "安装失败：$out"; return; }

	after=$(self_local)
	rm -f "$SELF_CACHE"

	# 装完再核对一次：万一 apk 真把版本装回去了，这里要能当场发现
	if [ -n "$after" ] && [ "$after" = "$before" ]; then
		reply_err "安装命令返回成功，但构建指纹没变（仍是 $before），可能并未真正替换"
		return
	fi
	# 这里**不能** reload rpcd：本次 ubus 调用正是由它处理的，重启会把回包弄丢，
	# 前端会看到超时（实测如此）。apk 覆盖后，下一次 call 本来就会用新脚本，
	# 不需要重启；只有全新安装才需要（由 post-install 负责）。

	json_init
	json_add_boolean ok 1
	json_add_string before "${before:-dev}"
	json_add_string after "${after:-dev}"
	json_dump
}

# ---------------------------------------------------------------- dispatch
case "$1" in
	list)
		json_init
		json_add_object status
		json_close_object
		json_add_object check
		json_close_object
		json_add_object log
		json_close_object
		json_add_object start
		json_close_object
		json_add_object setconfig
		json_add_string repo str
		json_add_string mirror str
		json_close_object
		json_add_object selfstatus
		json_close_object
		json_add_object selfcheck
		json_close_object
		json_add_object selfupdate
		json_close_object
		json_dump
		;;
	call)
		case "$2" in
			status)     do_status ;;
			check)      do_check ;;
			log)        do_log ;;
			start)      do_start ;;
			setconfig)  do_setconfig ;;
			selfstatus) do_self_status ;;
			selfcheck)  do_self_check ;;
			selfupdate) do_self_update ;;
			*)          reply_err "未知方法: $2" ;;
		esac
		;;
	*)
		echo "usage: $0 list | call <method>" >&2
		exit 1
		;;
esac
